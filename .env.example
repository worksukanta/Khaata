# Never put real secrets in this file.
# Copy this file to .env, fill in your values, and do not commit .env.

DJANGO_SECRET_KEY=replace-with-a-long-random-string
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# PostgreSQL — provide all five to use PostgreSQL, or omit all five for the
# local SQLite fallback (suitable for development without a database server).
# If only some are provided, the application will refuse to start.
DB_HOST=localhost
DB_PORT=5432
DB_NAME=khaata
DB_USER=khaata
DB_PASSWORD=replace-with-your-db-password

# Security — set both to true in production (HTTPS required).
SESSION_COOKIE_SECURE=false
CSRF_COOKIE_SECURE=false

# Origins — update for your local frontend port or production domain.
CSRF_TRUSTED_ORIGINS=http://localhost:5173

TIME_ZONE=Asia/Kolkata
