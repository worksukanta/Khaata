# Khaata Frontend — Environment Variables
# Copy this file to .env.local and fill in the values for local development.
# Never commit .env.local to version control.
#
# In production these values are injected at build time by the CI/CD pipeline.
# All VITE_ prefixed variables are embedded in the JS bundle at build time and
# are therefore NOT secrets.  Do not put secrets or credentials here.

# ---------------------------------------------------------------------------
# API base URL
# ---------------------------------------------------------------------------
# The URL of the Khaata Django backend.
# In local development the Vite dev server proxies /api/* to this origin
# (see vite.config.ts), so VITE_API_BASE_URL can be left empty here.
#
# Set a value only when the frontend is served from a different origin
# than the backend, e.g.:
#   VITE_API_BASE_URL=https://api.khaata.example.com
VITE_API_BASE_URL=
